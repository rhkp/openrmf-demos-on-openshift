# bootc-image-builder customization — copy to config.toml and edit
# (config.toml is gitignored, this .example is the committed template).
#
#   cp bootc-vm/config.toml.example bootc-vm/config.toml
#
# Creates a login user on the built image (fedora-bootc ships no default
# user/password). Replace the key below with your own SSH public key
# (any standard OpenSSH format — rsa, ed25519, ecdsa all work; no
# bootc-specific restriction) before building; AWS's own key-pair
# injection via cloud-init would also work if you'd rather rely on that
# instead, but fedora-bootc has no cloud-init, so it wouldn't take effect.
[[customizations.user]]
name = "admin"
groups = ["wheel"]
key = "REPLACE_WITH_YOUR_SSH_PUBLIC_KEY"

# bib's default root partition size isn't nearly enough for the bound
# workload images installed alongside the host OS — confirmed by a real
# build failure ("no space left on device") unpacking nav2-sensors (6.76 GB
# alone). Host image (~2 GB) + nav2-sensors (6.76 GB) + zenoh-router
# (970 MB) + novnc (180 MB) is already ~10 GB before any runtime headroom
# (ROS logs, /dev/shm-backed tmpfs, etc.) — size generously rather than
# tune this exactly, EC2 gp3 storage is cheap.
[[customizations.filesystem]]
mountpoint = "/"
minsize = "30 GiB"
