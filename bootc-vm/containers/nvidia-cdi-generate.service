# Not a Quadlet unit — Quadlet only generates units that run a Podman
# container; this is a host-level command (nvidia-ctk inspecting the real
# GPU/driver directly), so it has to be a plain systemd unit.
#
# CDI spec generation needs live GPU hardware to query (via NVML/nvidia-smi),
# which the CPU-only build VM doesn't have — so unlike the NVIDIA driver
# itself (baked into the image at build time), this must run at boot on the
# actual GPU instance. /var/run/cdi/ is cleared every boot anyway, so running
# this at every boot (rather than once) is the correct approach, not a
# workaround.
[Unit]
Description=Generate NVIDIA CDI spec for Podman GPU passthrough
# The driver module isn't loaded by the time this would otherwise run
# (confirmed by a real failure: NVML init failed with "Driver Not Loaded")
# without this explicit ordering — most units order after
# systemd-modules-load.service implicitly via sysinit.target, but making it
# explicit here since correctness of this one unit depends on it directly.
After=systemd-modules-load.service
Before=rmf-simulation.service

[Service]
Type=oneshot
ExecStart=/usr/bin/nvidia-ctk cdi generate --output=/var/run/cdi/nvidia.yaml
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
