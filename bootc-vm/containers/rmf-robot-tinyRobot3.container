# launch-robot.sh + wait-for-world.sh are overlaid from
# office/helm/files/ (proven, actually-running versions) — the copies
# baked into the app image are stale: they'd spawn a redundant per-robot
# fleet adapter, conflicting with the single fleet adapter now centralized
# in rmf-simulation.
[Unit]
Description=OpenRMF robot-as-pod: tinyRobot3 (Nav2 + SLAM)
After=rmf-simulation.service
Requires=rmf-simulation.service

[Container]
Image=quay.io/rhkp/openrmf-openshift-office-demo:nav2-sensors
ContainerName=rmf-robot-tinyRobot3
Network=host
Pull=never
GlobalArgs=--storage-opt=additionalimagestore=/usr/lib/bootc/storage
ShmSize=64m
Volume=/opt/rmf-overlay/launch-robot.sh:/opt/rmf/scripts/launch-robot.sh:ro
Volume=/opt/rmf-overlay/wait-for-world.sh:/opt/rmf/scripts/wait-for-world.sh:ro
Exec=/opt/rmf/scripts/launch-robot.sh
Environment=ROBOT_NAME=tinyRobot3
Environment=ZENOH_ROUTER_ENDPOINT=tcp/localhost:7447
Environment=QT_QPA_PLATFORM=offscreen
Environment=LIBGL_ALWAYS_SOFTWARE=1

[Service]
Restart=always
TimeoutStartSec=360

[Install]
WantedBy=multi-user.target
