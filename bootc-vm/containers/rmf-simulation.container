[Unit]
Description=OpenRMF office demo simulation (Gazebo + fleet adapters)
After=rmf-zenoh-router.service nvidia-cdi-generate.service
Requires=rmf-zenoh-router.service nvidia-cdi-generate.service

[Container]
Image=quay.io/rhkp/openrmf-openshift-office-demo:nav2-sensors
ContainerName=rmf-simulation
Network=host
Pull=never
GlobalArgs=--storage-opt=additionalimagestore=/usr/lib/bootc/storage
ShmSize=2g
# launch-simulation-world-only-viz.sh isn't baked into the app image at all
# (Helm-ConfigMap-only on OpenShift) — overlay it the same way Helm mounts
# it, from the copy baked into this host image at build time.
Volume=/opt/rmf-overlay/launch-simulation-world-only-viz.sh:/opt/rmf/scripts/launch-simulation-world-only-viz.sh:ro
Exec=/opt/rmf/scripts/launch-simulation-world-only-viz.sh
Environment=ZENOH_ROUTER_ENDPOINT=tcp/localhost:7447
Environment=RMF_VNC_PORT=5900
Environment=RMF_VNC_WIDTH=1920
Environment=RMF_VNC_HEIGHT=1080
# CDI device passthrough (supersedes the older NVIDIA_VISIBLE_DEVICES/
# NVIDIA_DRIVER_CAPABILITIES env-var+hook mechanism the Helm chart uses —
# mixing both can conflict per NVIDIA's own docs, so this is CDI-only).
AddDevice=nvidia.com/gpu=all

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
