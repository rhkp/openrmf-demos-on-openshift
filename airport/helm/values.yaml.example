# Copy to values.yaml and customize (values.yaml is gitignored)
#
#   cp airport/helm/values.yaml.example airport/helm/values.yaml

fullnameOverride: rmf-airport-demo

app:
  name: openrmf-airport-demo

namespace:
  name: rmf-demos

image:
  # Full Quay.io reference — shared image with office demo (includes both worlds)
  fullRef: quay.io/your-org/openrmf-openshift-office-demo:nav2-sensors
  pullPolicy: Always

# Optional — for private Quay repositories
pullSecret:
  name: ""  # e.g. quay-pull-secret

serviceAccount:
  create: false
  name: rmf-demo

demo:
  name: airport
  launchFile: airport_terminal.launch.xml

# Robot-as-individual-pod architecture (Nav2 + SLAM per robot)
# Set enabled: false for traditional all-in-one deployment
robots:
  enabled: true
  fleet_name: "tinyRobot"
  instances:
    - name: tinyRobot_0
    - name: tinyRobot_1
  resources:
    requests:
      cpu: "3"
      memory: "6Gi"
    limits:
      cpu: "4"
      memory: "8Gi"
  fleetCoordinator:
    enabled: false

dispatch:
  command: /opt/rmf/demos/airport/scripts/dispatch-task.sh
  startupWaitSeconds: 45
  readyWaitSeconds: 120

# RMF Web — 2D dashboard (map, robots, tasks)
rmfWeb:
  enabled: true
  serverUri: ws://rmf-airport-demo-api:80/_internal
  apiServer:
    image: quay.io/your-org/openrmf-rmf-web-zenoh:latest
    pullPolicy: Always
    rmwImplementation: rmw_zenoh_cpp
    resources:
      requests:
        cpu: 250m
        memory: 512Mi
      limits:
        cpu: "1"
        memory: 1Gi
  dashboard:
    image: ghcr.io/open-rmf/rmf-web/demo-dashboard:jazzy-nightly
    nginxImage: nginxinc/nginx-unprivileged:alpine
    pullPolicy: IfNotPresent
    resources:
      requests:
        cpu: 100m
        memory: 256Mi
      limits:
        cpu: 500m
        memory: 512Mi
  # Option A: OpenShift Routes (public access)
  routes:
    enabled: false
    clusterDomain: apps.example.openshift.com
    dashboardHost: ""
    apiHost: ""
    trajectoryHost: ""
  # Option B: oc port-forward (local-only access, when routes.enabled=false)
  #   Run: ./airport/port-forward.sh <namespace>
  portForward:
    dashboardPort: "3000"

# noVNC — stream Gazebo/RViz virtual desktop to browser
novnc:
  enabled: true
  image: quay.io/your-org/openrmf-openshift-airport-demo:novnc
  pullPolicy: Always
  vncPort: 5900
  webPort: 8080
  displayWidth: 1280
  displayHeight: 720
  resources:
    requests:
      cpu: 100m
      memory: 128Mi
    limits:
      cpu: 500m
      memory: 256Mi
  routes:
    enabled: false
    clusterDomain: apps.example.openshift.com
    novncHost: ""

# Zenoh Router — central message broker (replaces DDS)
zenoh:
  enabled: true
  image: quay.io/your-org/openrmf-zenoh-router:latest
  pullPolicy: Always
  port: 7447
  resources:
    requests:
      cpu: 100m
      memory: 128Mi
    limits:
      cpu: 250m
      memory: 256Mi

shm:
  sizeLimit: 64Mi

resources:
  simulation:
    requests:
      cpu: "4"
      memory: 8Gi
    limits:
      cpu: "8"
      memory: 12Gi
  # Used when novnc.enabled — Gazebo GUI + RViz need more CPU/RAM
  simulationViz:
    requests:
      cpu: "5"
      memory: 10Gi
    limits:
      cpu: "10"
      memory: 14Gi
  # Used when robots.enabled — world-only simulation (no robot processes)
  simulationWorldOnly:
    requests:
      cpu: "2"
      memory: "4Gi"
    limits:
      cpu: "3"
      memory: "6Gi"
  simulationWorldOnlyViz:
    requests:
      cpu: "4"
      memory: 4Gi
      nvidia.com/gpu: "1"
    limits:
      cpu: "6"
      memory: 8Gi
      nvidia.com/gpu: "1"
  fleetMonitor:
    requests:
      cpu: 250m
      memory: 512Mi
    limits:
      cpu: "1"
      memory: 1Gi
  taskDispatch:
    requests:
      cpu: 250m
      memory: 512Mi
    limits:
      cpu: "1"
      memory: 1Gi
