Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Map
      Name: SLAM Map (Robot1)
      Enabled: true
      Topic:
        Value: /tinyRobot1/map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Update Topic:
        Value: /tinyRobot1/map_updates
      Alpha: 0.7
      Color Scheme: map
      Draw Behind: true

    - Class: rviz_default_plugins/Map
      Name: SLAM Map (Robot2)
      Enabled: true
      Topic:
        Value: /tinyRobot2/map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Update Topic:
        Value: /tinyRobot2/map_updates
      Alpha: 0.5
      Color Scheme: costmap
      Draw Behind: true

    - Class: rviz_default_plugins/Map
      Name: SLAM Map (Robot3)
      Enabled: true
      Topic:
        Value: /tinyRobot3/map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Update Topic:
        Value: /tinyRobot3/map_updates
      Alpha: 0.4
      Color Scheme: map
      Draw Behind: true

    - Class: rviz_default_plugins/Map
      Name: SLAM Map (Robot4)
      Enabled: true
      Topic:
        Value: /tinyRobot4/map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Update Topic:
        Value: /tinyRobot4/map_updates
      Alpha: 0.4
      Color Scheme: costmap
      Draw Behind: true

    - Class: rviz_default_plugins/LaserScan
      Name: Lidar (Robot1)
      Enabled: true
      Topic:
        Value: /tinyRobot1/scan
        Depth: 5
        Reliability Policy: Best Effort
      Color Transformer: FlatColor
      Color: 255; 0; 0
      Size (m): 0.05
      Style: Points

    - Class: rviz_default_plugins/LaserScan
      Name: Lidar (Robot2)
      Enabled: true
      Topic:
        Value: /tinyRobot2/scan
        Depth: 5
        Reliability Policy: Best Effort
      Color Transformer: FlatColor
      Color: 255; 255; 0
      Size (m): 0.05
      Style: Points

    - Class: rviz_default_plugins/LaserScan
      Name: Lidar (Robot3)
      Enabled: true
      Topic:
        Value: /tinyRobot3/scan
        Depth: 5
        Reliability Policy: Best Effort
      Color Transformer: FlatColor
      Color: 0; 255; 0
      Size (m): 0.05
      Style: Points

    - Class: rviz_default_plugins/LaserScan
      Name: Lidar (Robot4)
      Enabled: true
      Topic:
        Value: /tinyRobot4/scan
        Depth: 5
        Reliability Policy: Best Effort
      Color Transformer: FlatColor
      Color: 0; 100; 255
      Size (m): 0.05
      Style: Points

    - Class: rviz_default_plugins/MarkerArray
      Name: Nav Graph
      Enabled: true
      Topic:
        Value: /nav_graph_markers
        Depth: 5
        Reliability Policy: Reliable

    - Class: rviz_default_plugins/Path
      Name: Nav2 Plan (Robot1)
      Enabled: true
      Topic:
        Value: /tinyRobot1/plan
        Depth: 5
        Reliability Policy: Reliable
      Color: 255; 0; 0
      Line Style: Lines
      Line Width: 0.03
      Alpha: 1.0

    - Class: rviz_default_plugins/Path
      Name: Nav2 Plan (Robot2)
      Enabled: true
      Topic:
        Value: /tinyRobot2/plan
        Depth: 5
        Reliability Policy: Reliable
      Color: 255; 255; 0
      Line Style: Lines
      Line Width: 0.03
      Alpha: 1.0

    - Class: rviz_default_plugins/Path
      Name: Nav2 Plan (Robot3)
      Enabled: true
      Topic:
        Value: /tinyRobot3/plan
        Depth: 5
        Reliability Policy: Reliable
      Color: 0; 255; 0
      Line Style: Lines
      Line Width: 0.03
      Alpha: 1.0

    - Class: rviz_default_plugins/Path
      Name: Nav2 Plan (Robot4)
      Enabled: true
      Topic:
        Value: /tinyRobot4/plan
        Depth: 5
        Reliability Policy: Reliable
      Color: 0; 100; 255
      Line Style: Lines
      Line Width: 0.03
      Alpha: 1.0

    - Class: rviz_default_plugins/Map
      Name: Local Costmap (Robot1)
      Enabled: true
      Topic:
        Value: /tinyRobot1/local_costmap/costmap
        Depth: 1
        Reliability Policy: Reliable
      Alpha: 0.3
      Color Scheme: costmap
      Draw Behind: false

    - Class: rviz_default_plugins/Map
      Name: Local Costmap (Robot2)
      Enabled: true
      Topic:
        Value: /tinyRobot2/local_costmap/costmap
        Depth: 1
        Reliability Policy: Reliable
      Alpha: 0.3
      Color Scheme: costmap
      Draw Behind: false

    - Class: rviz_default_plugins/Map
      Name: Local Costmap (Robot3)
      Enabled: true
      Topic:
        Value: /tinyRobot3/local_costmap/costmap
        Depth: 1
        Reliability Policy: Reliable
      Alpha: 0.3
      Color Scheme: costmap
      Draw Behind: false

    - Class: rviz_default_plugins/Map
      Name: Local Costmap (Robot4)
      Enabled: true
      Topic:
        Value: /tinyRobot4/local_costmap/costmap
        Depth: 1
        Reliability Policy: Reliable
      Alpha: 0.3
      Color Scheme: costmap
      Draw Behind: false

    - Class: rviz_default_plugins/Polygon
      Name: Slow Zone (Robot1)
      Enabled: true
      Topic:
        Value: /tinyRobot1/polygon_slow
        Depth: 1
        Reliability Policy: Reliable
      Color: 0; 255; 0
      Alpha: 0.3

    - Class: rviz_default_plugins/Polygon
      Name: Stop Zone (Robot1)
      Enabled: true
      Topic:
        Value: /tinyRobot1/polygon_stop
        Depth: 1
        Reliability Policy: Reliable
      Color: 255; 0; 0
      Alpha: 0.3

    - Class: rviz_default_plugins/Polygon
      Name: Slow Zone (Robot2)
      Enabled: true
      Topic:
        Value: /tinyRobot2/polygon_slow
        Depth: 1
        Reliability Policy: Reliable
      Color: 0; 255; 0
      Alpha: 0.3

    - Class: rviz_default_plugins/Polygon
      Name: Stop Zone (Robot2)
      Enabled: true
      Topic:
        Value: /tinyRobot2/polygon_stop
        Depth: 1
        Reliability Policy: Reliable
      Color: 255; 0; 0
      Alpha: 0.3

    - Class: rviz_default_plugins/Polygon
      Name: Slow Zone (Robot3)
      Enabled: true
      Topic:
        Value: /tinyRobot3/polygon_slow
        Depth: 1
        Reliability Policy: Reliable
      Color: 0; 255; 0
      Alpha: 0.3

    - Class: rviz_default_plugins/Polygon
      Name: Stop Zone (Robot3)
      Enabled: true
      Topic:
        Value: /tinyRobot3/polygon_stop
        Depth: 1
        Reliability Policy: Reliable
      Color: 255; 0; 0
      Alpha: 0.3

    - Class: rviz_default_plugins/Polygon
      Name: Slow Zone (Robot4)
      Enabled: true
      Topic:
        Value: /tinyRobot4/polygon_slow
        Depth: 1
        Reliability Policy: Reliable
      Color: 0; 255; 0
      Alpha: 0.3

    - Class: rviz_default_plugins/Polygon
      Name: Stop Zone (Robot4)
      Enabled: true
      Topic:
        Value: /tinyRobot4/polygon_stop
        Depth: 1
        Reliability Policy: Reliable
      Color: 255; 0; 0
      Alpha: 0.3

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Frame Timeout: 15
      Frames:
        All Enabled: true

    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Line Style:
        Value: Lines
      Color: 160; 160; 164
      Plane Cell Count: 50

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 15
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDownOrtho
      Scale: 30
      X: 10
      Y: -5
Window Geometry:
  Width: 900
  Height: 700
  Displays:
    collapsed: false
