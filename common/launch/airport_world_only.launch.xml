<?xml version='1.0' ?>

<launch>
  <!-- Airport world-only launch for robot-as-pod architecture.
       Runs Gazebo simulation + RMF core services, but NOT fleet adapters
       (those run in separate robot pods with Nav2/SLAM). -->

  <arg name="use_sim_time" default="true"/>
  <arg name="failover_mode" default="false"/>
  <arg name="gazebo_version" default='8'/>
  <arg name="sim_update_rate" default='100'/>
  <arg name="headless" default="1"/>
  <arg name="server_uri" default="" description="The URI of the api server to transmit state and task information."/>
  <arg name="gz_world_name" default="airport_terminal" description="World element name in SDF (for gz-transport topic paths)"/>

  <!-- Core RMF services (traffic scheduler, map server, doors, lifts, dispatcher) -->
  <include file="$(find-pkg-share rmf_demos)/common.launch.xml">
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="viz_config_file" value="$(find-pkg-share rmf_demos)/include/airport_terminal/airport_terminal.rviz"/>
    <arg name="config_file" value="$(find-pkg-share rmf_demos_maps)/airport_terminal/airport_terminal.building.yaml"/>
    <arg name="headless" value="$(var headless)"/>
    <arg name="server_uri" value="$(var server_uri)"/>
  </include>

  <!-- Gazebo simulation - headless with EGL GPU sensor rendering -->
  <let name="world_path" value="$(find-pkg-share rmf_demos_maps)/maps/airport_terminal/airport_terminal.world" />
  <let name="model_path" value="$(find-pkg-share rmf_demos_maps)/maps/airport_terminal/models:$(env HOME)/.gazebo/models" />

  <let name="gz_headless" if="$(var headless)" value="-s"/>
  <let name="gz_headless" unless="$(var headless)" value="" />
  <let name="gz_render" if="$(var headless)" value="--headless-rendering"/>
  <let name="gz_render" unless="$(var headless)" value="" />

  <executable cmd="gz sim --force-version $(var gazebo_version) $(var gz_headless) $(var gz_render) -r -v 3 $(var world_path)" output="both">
    <env name="GZ_SIM_RESOURCE_PATH" value="$(env GZ_SIM_RESOURCE_PATH):$(var model_path)" />
  </executable>

  <node pkg="ros_gz_bridge" exec="parameter_bridge"
    args="/clock@rosgraph_msgs/msg/Clock[gz.msgs.Clock" />

  <!-- ros_gz_bridge for lidar scan topics (gz-sim to ROS2) -->
  <node pkg="ros_gz_bridge" exec="parameter_bridge"
    args="/world/$(var gz_world_name)/model/tinyRobot_0/link/lidar_link/sensor/lidar/scan@sensor_msgs/msg/LaserScan[gz.msgs.LaserScan"
    name="lidar_bridge_robot0">
    <remap from="/world/$(var gz_world_name)/model/tinyRobot_0/link/lidar_link/sensor/lidar/scan"
           to="/tinyRobot_0/scan" />
  </node>

  <node pkg="ros_gz_bridge" exec="parameter_bridge"
    args="/world/$(var gz_world_name)/model/tinyRobot_1/link/lidar_link/sensor/lidar/scan@sensor_msgs/msg/LaserScan[gz.msgs.LaserScan"
    name="lidar_bridge_robot1">
    <remap from="/world/$(var gz_world_name)/model/tinyRobot_1/link/lidar_link/sensor/lidar/scan"
           to="/tinyRobot_1/scan" />
  </node>

  <!-- ros_gz_bridge for cmd_vel: Nav2 (ROS2) → DiffDrive (gz-sim) -->
  <node pkg="ros_gz_bridge" exec="parameter_bridge"
    args="/model/tinyRobot_0/cmd_vel@geometry_msgs/msg/Twist]gz.msgs.Twist"
    name="cmd_vel_bridge_robot0">
    <remap from="/model/tinyRobot_0/cmd_vel" to="/tinyRobot_0/cmd_vel" />
  </node>

  <node pkg="ros_gz_bridge" exec="parameter_bridge"
    args="/model/tinyRobot_1/cmd_vel@geometry_msgs/msg/Twist]gz.msgs.Twist"
    name="cmd_vel_bridge_robot1">
    <remap from="/model/tinyRobot_1/cmd_vel" to="/tinyRobot_1/cmd_vel" />
  </node>

  <!-- NOTE: fleet adapters are NOT included here - they run in separate robot pods -->

</launch>
