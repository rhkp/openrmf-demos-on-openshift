<?xml version="1.0"?>
<launch>
  <arg name="robot_name" description="Name of the robot (e.g., tinyRobot1)" />
  <arg name="use_sim_time" default="true" />
  <arg name="nav2_params_file" default="/opt/rmf/config/nav2_params.yaml" />
  <arg name="slam_params_file" default="/opt/rmf/config/slam_toolbox_params.yaml" />

  <group>
    <push-ros-namespace namespace="$(var robot_name)" />

    <!-- Nav2 navigation stack (RewrittenYaml wraps params under namespace) -->
    <include file="$(find-pkg-share nav2_bringup)/launch/navigation_launch.py">
      <arg name="namespace" value="$(var robot_name)" />
      <arg name="use_sim_time" value="$(var use_sim_time)" />
      <arg name="params_file" value="$(var nav2_params_file)" />
      <arg name="autostart" value="true" />
      <arg name="use_composition" value="False" />
    </include>

    <!-- SLAM Toolbox -->
    <node pkg="slam_toolbox" exec="sync_slam_toolbox_node" name="slam_toolbox" output="screen">
      <param from="$(var slam_params_file)" />
      <param name="use_sim_time" value="$(var use_sim_time)" />
      <remap from="/tf" to="tf" />
      <remap from="/tf_static" to="tf_static" />
      <remap from="/map" to="map" />
      <remap from="/map_metadata" to="map_metadata" />
    </node>

    <!-- Lifecycle manager for SLAM Toolbox (sync_slam_toolbox_node is a lifecycle node).
         bond_timeout=0 because SLAM Toolbox uses rclcpp_lifecycle directly, not nav2_util::LifecycleNode,
         so it doesn't create a bond. -->
    <node pkg="nav2_lifecycle_manager" exec="lifecycle_manager" name="lifecycle_manager_slam" output="screen">
      <param name="use_sim_time" value="$(var use_sim_time)" />
      <param name="autostart" value="true" />
      <param name="bond_timeout" value="0.0" />
      <param name="node_names" value="['slam_toolbox']" />
    </node>
  </group>
</launch>