<?xml version='1.0' ?>

<launch>
  <!-- Office world-only launch for robot-as-pod architecture.
       This runs everything from office.launch.xml EXCEPT the fleet adapter,
       which runs in separate robot pods instead. -->

  <arg name="use_sim_time" default="true"/>
  <arg name="failover_mode" default="false"/>
  <arg name="gazebo_version" default='8'/>
  <arg name="sim_update_rate" default='100'/>
  <arg name="headless" default="1"/>
  <arg name="server_uri" default="" description="The URI of the api server to transmit state and task information."/>

  <!-- Core RMF services (from common.launch.xml) - traffic, map, viz, doors, lifts, dispatcher -->
  <include file="$(find-pkg-share rmf_demos)/common.launch.xml">
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="viz_config_file" value="$(find-pkg-share rmf_demos)/include/office/office.rviz"/>
    <arg name="config_file" value="$(find-pkg-share rmf_demos_maps)/office/office.building.yaml"/>
    <arg name="headless" value="$(var headless)"/>
    <arg name="server_uri" value="$(var server_uri)"/>
  </include>

  <!-- Gazebo simulation - inlined with headless-rendering for EGL GPU sensor rendering -->
  <let name="world_path" value="$(find-pkg-share rmf_demos_maps)/maps/office/office.world" />
  <let name="model_path" value="$(find-pkg-share rmf_demos_maps)/maps/office/models:$(env HOME)/.gazebo/models" />

  <let name="gz_headless" if="$(var headless)" value="-s"/>
  <let name="gz_headless" unless="$(var headless)" value="" />

  <executable cmd="gz sim --force-version $(var gazebo_version) $(var gz_headless) -r -v 3 $(var world_path)" output="both">
    <env name="GZ_SIM_RESOURCE_PATH" value="$(env GZ_SIM_RESOURCE_PATH):$(var model_path)" />
  </executable>

  <node pkg="ros_gz_bridge" exec="parameter_bridge"
    args="/clock@rosgraph_msgs/msg/Clock[gz.msgs.Clock" />

  <!-- ros_gz_bridge for lidar scan topics (gz-sim to ROS2) -->
  <node pkg="ros_gz_bridge" exec="parameter_bridge"
    args="/world/sim_world/model/tinyRobot1/link/lidar_link/sensor/lidar/scan@sensor_msgs/msg/LaserScan[gz.msgs.LaserScan"
    name="lidar_bridge_robot1">
    <remap from="/world/sim_world/model/tinyRobot1/link/lidar_link/sensor/lidar/scan"
           to="/tinyRobot1/scan" />
  </node>

  <node pkg="ros_gz_bridge" exec="parameter_bridge"
    args="/world/sim_world/model/tinyRobot2/link/lidar_link/sensor/lidar/scan@sensor_msgs/msg/LaserScan[gz.msgs.LaserScan"
    name="lidar_bridge_robot2">
    <remap from="/world/sim_world/model/tinyRobot2/link/lidar_link/sensor/lidar/scan"
           to="/tinyRobot2/scan" />
  </node>

  <!-- ros_gz_bridge for cmd_vel: Nav2 (ROS2) → DiffDrive (gz-sim) -->
  <node pkg="ros_gz_bridge" exec="parameter_bridge"
    args="/model/tinyRobot1/cmd_vel@geometry_msgs/msg/Twist]gz.msgs.Twist"
    name="cmd_vel_bridge_robot1">
    <remap from="/model/tinyRobot1/cmd_vel" to="/tinyRobot1/cmd_vel" />
  </node>

  <node pkg="ros_gz_bridge" exec="parameter_bridge"
    args="/model/tinyRobot2/cmd_vel@geometry_msgs/msg/Twist]gz.msgs.Twist"
    name="cmd_vel_bridge_robot2">
    <remap from="/model/tinyRobot2/cmd_vel" to="/tinyRobot2/cmd_vel" />
  </node>

  <!-- ros_gz_bridge for odometry: DiffDrive (gz-sim) → Nav2/TF publisher (ROS2) -->
  <node pkg="ros_gz_bridge" exec="parameter_bridge"
    args="/model/tinyRobot1/odometry@nav_msgs/msg/Odometry[gz.msgs.Odometry"
    name="odom_bridge_robot1">
    <remap from="/model/tinyRobot1/odometry" to="/tinyRobot1/odom" />
  </node>

  <node pkg="ros_gz_bridge" exec="parameter_bridge"
    args="/model/tinyRobot2/odometry@nav_msgs/msg/Odometry[gz.msgs.Odometry"
    name="odom_bridge_robot2">
    <remap from="/model/tinyRobot2/odometry" to="/tinyRobot2/odom" />
  </node>

  <!-- NOTE: fleet adapter is NOT included here - it runs in separate robot pods -->

</launch>