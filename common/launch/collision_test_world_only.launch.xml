<?xml version='1.0' ?>

<launch>
  <arg name="use_sim_time" default="true"/>
  <arg name="headless" default="1"/>

  <!-- Gazebo simulation of the collision test room -->
  <let name="world_path" value="/opt/rmf/worlds/collision_test.world" />
  <let name="model_path" value="$(find-pkg-share rmf_demos_assets)/models:$(env HOME)/.gazebo/models" />

  <let name="gz_headless" if="$(var headless)" value="-s"/>
  <let name="gz_headless" unless="$(var headless)" value="" />
  <let name="gz_render" if="$(var headless)" value="--headless-rendering"/>
  <let name="gz_render" unless="$(var headless)" value="" />

  <executable cmd="gz sim --force-version 8 $(var gz_headless) $(var gz_render) -r -v 3 $(var world_path)" output="both">
    <env name="GZ_SIM_RESOURCE_PATH" value="$(env GZ_SIM_RESOURCE_PATH):$(var model_path)" />
  </executable>

  <!-- Clock bridge -->
  <node pkg="ros_gz_bridge" exec="parameter_bridge"
    args="/clock@rosgraph_msgs/msg/Clock[gz.msgs.Clock" />

  <!-- Lidar bridges -->
  <node pkg="ros_gz_bridge" exec="parameter_bridge"
    args="/world/collision_test/model/tinyRobot1/link/lidar_link/sensor/lidar/scan@sensor_msgs/msg/LaserScan[gz.msgs.LaserScan"
    name="lidar_bridge_robot1">
    <remap from="/world/collision_test/model/tinyRobot1/link/lidar_link/sensor/lidar/scan"
           to="/tinyRobot1/scan" />
  </node>

  <node pkg="ros_gz_bridge" exec="parameter_bridge"
    args="/world/collision_test/model/tinyRobot2/link/lidar_link/sensor/lidar/scan@sensor_msgs/msg/LaserScan[gz.msgs.LaserScan"
    name="lidar_bridge_robot2">
    <remap from="/world/collision_test/model/tinyRobot2/link/lidar_link/sensor/lidar/scan"
           to="/tinyRobot2/scan" />
  </node>

  <node pkg="ros_gz_bridge" exec="parameter_bridge"
    args="/world/collision_test/model/tinyRobot3/link/lidar_link/sensor/lidar/scan@sensor_msgs/msg/LaserScan[gz.msgs.LaserScan"
    name="lidar_bridge_robot3">
    <remap from="/world/collision_test/model/tinyRobot3/link/lidar_link/sensor/lidar/scan"
           to="/tinyRobot3/scan" />
  </node>

  <node pkg="ros_gz_bridge" exec="parameter_bridge"
    args="/world/collision_test/model/tinyRobot4/link/lidar_link/sensor/lidar/scan@sensor_msgs/msg/LaserScan[gz.msgs.LaserScan"
    name="lidar_bridge_robot4">
    <remap from="/world/collision_test/model/tinyRobot4/link/lidar_link/sensor/lidar/scan"
           to="/tinyRobot4/scan" />
  </node>

  <!-- cmd_vel bridges: Nav2 (ROS2) to DiffDrive (gz-sim) -->
  <node pkg="ros_gz_bridge" exec="parameter_bridge"
    args="/model/tinyRobot1/cmd_vel@geometry_msgs/msg/Twist]gz.msgs.Twist"
    name="cmd_vel_bridge_robot1">
    <remap from="/model/tinyRobot1/cmd_vel" to="/tinyRobot1/cmd_vel" />
  </node>

  <node pkg="ros_gz_bridge" exec="parameter_bridge"
    args="/model/tinyRobot2/cmd_vel@geometry_msgs/msg/Twist]gz.msgs.Twist"
    name="cmd_vel_bridge_robot2">
    <remap from="/model/tinyRobot2/cmd_vel" to="/tinyRobot2/cmd_vel" />
  </node>

  <node pkg="ros_gz_bridge" exec="parameter_bridge"
    args="/model/tinyRobot3/cmd_vel@geometry_msgs/msg/Twist]gz.msgs.Twist"
    name="cmd_vel_bridge_robot3">
    <remap from="/model/tinyRobot3/cmd_vel" to="/tinyRobot3/cmd_vel" />
  </node>

  <node pkg="ros_gz_bridge" exec="parameter_bridge"
    args="/model/tinyRobot4/cmd_vel@geometry_msgs/msg/Twist]gz.msgs.Twist"
    name="cmd_vel_bridge_robot4">
    <remap from="/model/tinyRobot4/cmd_vel" to="/tinyRobot4/cmd_vel" />
  </node>

</launch>
